# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_URL=https://dal.yourdomain.com
FRONTEND_URL=https://dal.yourdomain.com

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL="mysql://dal_user:STRONG_PASSWORD@127.0.0.1:3306/dal_db"

# ─── JWT ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_64_char_random_string_here_xxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_to_64_char_random_string_refresh_xxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Storage ──────────────────────────────────────────────────────
# Absolute path to storage directory (outside public/)
STORAGE_PATH=/var/www/dal-system/backend/storage

# ─── Email (Gmail SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="DAL System <your.gmail@gmail.com>"

# ─── Cookie ───────────────────────────────────────────────────────
COOKIE_SECRET=change_me_to_32_char_random_string_here

# ─── Rate Limit ───────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# ─── Account Lock ─────────────────────────────────────────────────
LOGIN_LOCK_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=1800000

# ─── Log ──────────────────────────────────────────────────────────
LOG_DIR=/var/www/dal-system/backend/logs
LOG_LEVEL=info

# ─── Seed ─────────────────────────────────────────────────────────
# Password for initial superadmin (used only during `node prisma/seed.js`)
# Change immediately after first login
SEED_ADMIN_PASSWORD=Admin@DAL2026!
