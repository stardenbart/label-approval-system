# =============================================================================
# DAL System — Backend environment (template PRODUKSI)
#
#   cp .env.example .env      lalu isi setiap nilai bertanda GANTI
#
# Berkas ini SATU-SATUNYA contoh env yang ikut ke git: root .gitignore memblokir
# semua pola `.env.*` kecuali `.env.example`. Jangan menaruh nilai asli di sini.
#
# Nilainya disetel untuk STAGING/PRODUKSI. Untuk development lokal, yang perlu
# diubah ditandai "dev:" pada barisnya.
#
# Setelah mengisi berkas ini, jalankan `npm run storage:doctor` — ia memeriksa
# sebagian besar kesalahan konfigurasi yang paling sering terjadi.
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production                              # dev: development
PORT=3001
USE_HTTPS=true                                   # dev: false
APP_URL=https://dal.yourdomain.com               # dev: http://localhost:5173
FRONTEND_URL=https://dal.yourdomain.com          # dev: http://localhost:5173
#
# APP_URL menentukan alamat yang dituju QR pada label TERCETAK. Salah di sini
# berarti label yang sudah dicetak menunjuk ke alamat yang tidak ada, dan itu
# tidak bisa diperbaiki tanpa cetak ulang. Periksa sebelum dokumen pertama
# di-approve di lingkungan baru.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://dal_user:GANTI_PASSWORD_KUAT@127.0.0.1:3306/dal_db"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=GANTI_48_byte_hex
JWT_REFRESH_SECRET=GANTI_48_byte_hex_yang_BERBEDA
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECRET=GANTI_minimal_32_karakter_acak

# ─── Storage ─────────────────────────────────────────────────────────────────
# WAJIB path absolut. PM2 menyetel cwd sendiri sementara skrip cron biasanya
# tidak, jadi path relatif membuat keduanya menulis ke folder berbeda tanpa
# keluhan apa pun.
#
# Folder `tmp` dan `documents` di bawahnya HARUS satu filesystem: dedup memakai
# hard link, dan lintas partisi ia jatuh ke salinan penuh tanpa satu pun error.
# Jangan me-mount salah satunya ke volume terpisah.
STORAGE_PATH=/var/www/dal-system/backend/storage # dev: ./storage

# ─── Ghostscript (opsional) ──────────────────────────────────────────────────
# Mengompresi berkas arsip: ~58% lebih kecil tanpa menurunkan resolusi gambar.
# Kalau tidak terpasang, kompresi dilewati dengan peringatan di log boot dan
# tidak ada alur kerja yang berhenti.
#     sudo apt install ghostscript
# Preset diatur di System Settings, kunci `archive_compression_preset`
# (none / prepress / ebook / screen). Lihat deploy/RUNBOOK-STORAGE.md.
# GS_BINARY=/usr/bin/gs
# GS_TIMEOUT_MS=120000

# ─── Backup ──────────────────────────────────────────────────────────────────
# Dipakai deploy/backup.sh, dan dibaca storage:doctor untuk memeriksa umur
# backup terakhir.
BACKUP_DIR=/var/backups/dal

# ─── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Untuk development pakai Mailtrap/Ethereal — JANGAN SMTP produksi, notifikasi
# approval akan terkirim ke alamat user asli.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=GANTI_gmail_app_password
SMTP_FROM="DAL System <your.gmail@gmail.com>"

# ─── Rate limit ──────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MS=60000

# ─── Kunci akun ──────────────────────────────────────────────────────────────
LOGIN_LOCK_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=1800000

# ─── Log ─────────────────────────────────────────────────────────────────────
LOG_DIR=/var/www/dal-system/backend/logs         # dev: ./logs
LOG_LEVEL=info                                   # dev: debug

# ─── Seed ────────────────────────────────────────────────────────────────────
# Hanya dibaca prisma/seed.js saat membuat akun awal. Ganti password superadmin
# segera setelah login pertama.
SEED_ADMIN_PASSWORD=GANTI_password_kuat
SEED_UPLOADER_PASSWORD=GANTI_password_kuat
