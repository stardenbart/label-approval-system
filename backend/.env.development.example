# ─────────────────────────────────────────────────────────────────
# DAL System — Backend ENV untuk DEVELOPMENT LOKAL
#
# Cara pakai:
#   cp .env.development.example .env
#
# CATATAN: file `.env` yang ikut dalam paket handover ini adalah
# SNAPSHOT KONFIGURASI PRODUKSI (server 172.20.240.49). Jangan dipakai
# langsung untuk development — path storage/log-nya menunjuk ke
# /var/www/... dan SMTP-nya mengirim email ke user asli.
# ─────────────────────────────────────────────────────────────────

# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
USE_HTTPS=false
PORT=3001
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────
# Sesuaikan user/password dengan MySQL lokal kamu
DATABASE_URL="mysql://root:yourpassword@127.0.0.1:3306/dal_db"

# ─── JWT ──────────────────────────────────────────────────────────
# WAJIB diganti. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=ganti_dengan_random_48_byte_hex
JWT_REFRESH_SECRET=ganti_dengan_random_48_byte_hex_berbeda
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Storage ──────────────────────────────────────────────────────
# Path absolut. Windows contoh: C:/dev/dal-system/backend/storage
STORAGE_PATH=./storage

# ─── Email (SMTP) ─────────────────────────────────────────────────
# Untuk dev, disarankan pakai Mailtrap / Ethereal, JANGAN SMTP produksi.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DAL System Dev <no-reply@localhost>"

# ─── Cookie ───────────────────────────────────────────────────────
COOKIE_SECRET=ganti_dengan_random_string

# ─── Rate Limit ───────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=30
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=60000

# ─── Account Lock ─────────────────────────────────────────────────
LOGIN_LOCK_ATTEMPTS=5
LOGIN_LOCK_DURATION_MS=900000

# ─── Log ──────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=debug

# ─── Seed ─────────────────────────────────────────────────────────
SEED_ADMIN_PASSWORD=ganti_dengan_password_admin_dev_yang_kuat
