    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.3.136",
    "qrcode": "^1.5.3",
    "react-draggable": "^4.4.5",
    "uuid": "^10.0.0",
